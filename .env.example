# Copia este archivo a .env y complétalo con los datos de tu proyecto en
# https://supabase.com/dashboard -> tu proyecto -> Project Settings -> API
#
# VITE_SUPABASE_ANON_KEY acepta tanto el "anon key" legacy (JWT) como el
# nuevo "publishable key" (formato sb_publishable_...) — cualquiera de los
# dos formatos funciona igual con @supabase/supabase-js.

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-o-publishable-key

# Delfin Mode -- voz en tiempo real (migración de la integración con
# LiveKit, plan gratuito). Esta URL NO es secreta -- es la dirección
# del servidor WebSocket al que se conecta el navegador, con formato
# wss://tu-proyecto.livekit.cloud. Se obtiene en livekit.io -> tu
# proyecto -> Settings -> Project. La API key y el API secret de
# LiveKit NUNCA van acá -- esas dos son secretas y solo se configuran
# del lado del servidor, como variables de entorno de la función Edge
# supabase/functions/livekit-token (ver el comentario al principio de
# ese archivo). Mientras esta variable quede vacía, el botón "Unirse
# por voz" de /voice queda deshabilitado con un aviso.
VITE_LIVEKIT_URL=
