# Copia este archivo a .env y complétalo con los datos de tu proyecto en
# https://supabase.com/dashboard -> tu proyecto -> Project Settings -> API
#
# VITE_SUPABASE_ANON_KEY acepta tanto el "anon key" legacy (JWT) como el
# nuevo "publishable key" (formato sb_publishable_...) — cualquiera de los
# dos formatos funciona igual con @supabase/supabase-js.

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-o-publishable-key
